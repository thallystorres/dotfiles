#!/usr/bin/env zsh
# vim: set filetype=zsh :
# Resolve from this file's own real path so it works regardless of $HOME layout
ZSH_CONFIG_DIR="${0:A:h}"
# Keep DOTFILES_DIR in sync for downstream scripts that read it
DOTFILES_DIR="${ZSH_CONFIG_DIR:h:h}"

CONFIG_CONFIG_FILE="${ZSH_CONFIG_DIR}/config"
FUNCTIONS_CONFIG_FILE="${ZSH_CONFIG_DIR}/functions"
EXPORTS_CONFIG_FILE="${ZSH_CONFIG_DIR}/exports"
ALIASES_CONFIG_FILE="${ZSH_CONFIG_DIR}/aliases"
KEYBINDS_CONFIG_FILE="${ZSH_CONFIG_DIR}/keybinds"

ZSH_CONFIG_FILES=(
  $CONFIG_CONFIG_FILE 
  $FUNCTIONS_CONFIG_FILE 
  $EXPORTS_CONFIG_FILE
  $ALIASES_CONFIG_FILE 
  $KEYBINDS_CONFIG_FILE
)

for f in "${ZSH_CONFIG_FILES[@]}"; do
  if test -f "$f"; then
    source $f
  else
    printf "404: $f not found.\n"
  fi
done

# Exports
[[ -f ~/.env ]] && source ~/.env

